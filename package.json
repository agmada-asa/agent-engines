{
  "name": "agent-engines",
  "version": "0.4.0",
  "description": "One multi-provider agent layer: Codex app-server and the Claude Agent SDK behind one thread, turn and event API.",
  "license": "MIT",
  "author": "Agmada Allen Asa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agmada-asa/agent-engines.git"
  },
  "homepage": "https://github.com/agmada-asa/agent-engines#readme",
  "bugs": {
    "url": "https://github.com/agmada-asa/agent-engines/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "test:live": "AGENT_ENGINES_LIVE=1 node --import tsx --test test/live/*.test.ts",
    "generate:protocol": "node scripts/generate-protocol.mjs",
    "check:runtimes": "node --import tsx scripts/check-runtimes.ts",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.308"
  },
  "devDependencies": {
    "@types/node": "^22.17.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2"
  },
  "keywords": [
    "codex",
    "claude",
    "claude-agent-sdk",
    "agents",
    "app-server",
    "llm"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
